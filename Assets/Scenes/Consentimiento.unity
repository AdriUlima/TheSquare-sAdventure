--- !u!114 &1224037401
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1224037399}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "mayor de edad, doy mi consentimiento para participar en la investigaci\xF3n <b>\u201CGeneraci\xF3n procedural de niveles para puzzles Ice-Sliding: dise\xF1o del algoritmo y evaluaci\xF3n de satisfacci\xF3n en jugadores j\xF3venes\u201D</b>, a cargo del investigador Adri\xE1n Duarte Romero, de la carrera de Ingenier\xEDa de Sistemas de la Universidad de Lima.\n\r\nDeclaro que he sido claramente informad@, mediante la carta de presentaci\xF3n sobre la investigaci\xF3n y su objetivo, el modo en que participar\xE9, los riesgos y beneficios de mi participaci\xF3n, la voluntariedad de mi participaci\xF3n, mi derecho a retirarme del estudio en cualquier momento, y el tratamiento y la confidencialidad de los datos.\r\n\nTambi\xE9n he recibido informaci\xF3n acerca del investigador responsable y el Comit\xE9 de \xC9tica al que puedo recurrir ante alguna consulta.\r\n\nTengo conocimiento de que el tratamiento de los datos y su confidencialidad ser\xE1n preservados, que los datos personales que proporcione ser\xE1n tratados <b>de acuerdo con lo establecido en la Ley de Protecci\xF3n de Datos Personales, Ley 29733</b>, y autorizo que mi informaci\xF3n se utilice de manera an\xF3nima en esta investigaci\xF3n y sus productos cient\xEDficos (informes, art\xEDculos, p\xF3steres, entre otros).\r\n\nDe igual forma, me comprometo a guardar estricta confidencialidad sobre toda la informaci\xF3n a la que tenga acceso o de la que tenga conocimiento como parte de mi participaci\xF3n voluntaria en la presente investigaci\xF3n."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
